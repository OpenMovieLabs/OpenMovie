{
  "name": "openmovie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The open-source harness for building, testing, and iterating AI-native films.",
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean",
    "dev": "pnpm --filter @openmovie/desktop dev",
    "dev:core": "pnpm --filter @openmovie/core dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "mcp": "pnpm --filter @openmovie/mcp-server dev --",
    "perf:baseline": "node --import tsx scripts/performance-baseline.ts",
    "cli": "pnpm --filter @openmovie/cli dev --",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
