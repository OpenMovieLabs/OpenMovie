{
  "name": "@openmovie/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "openmovie-mcp": "dist/main.js"
  },
  "scripts": {
    "build": "tsup src/main.ts --format esm --platform node --target node22 --clean --sourcemap",
    "clean": "rimraf dist",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@openmovie/project-store": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "rimraf": "6.0.1",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
