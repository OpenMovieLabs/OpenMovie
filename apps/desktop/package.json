{
  "name": "@openmovie/desktop",
  "version": "0.0.0",
  "private": true,
  "author": "OpenMovie Labs",
  "license": "0BSD",
  "packageManager": "pnpm@11.23.0",
  "description": "OpenMovie desktop workbench",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "pnpm --filter @openmovie/core build && electron-vite build",
    "clean": "rimraf out",
    "dev": "pnpm --filter @openmovie/core build && electron-vite dev",
    "package": "pnpm build && electron-builder --publish never",
    "package:dir": "pnpm build && electron-builder --dir --publish never",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@openmovie/contracts": "workspace:*",
    "@openmovie/movie-ir": "workspace:*",
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "rimraf": "^6.0.1",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "labs.openmovie.desktop",
    "productName": "OpenMovie",
    "directories": {
      "output": "../../release/${version}"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "../core/dist",
        "to": "core",
        "filter": [
          "main.cjs",
          "main.cjs.map"
        ]
      },
      {
        "from": "../core/build/Release/better_sqlite3.node",
        "to": "build/Release/better_sqlite3.node"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "OpenMovieLabs",
        "repo": "OpenMovie",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "resources/icon.png",
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
